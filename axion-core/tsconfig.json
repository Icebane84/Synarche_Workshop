{
    "compilerOptions": {
        "target": "ES2022",
        "module": "NodeNext",
        "lib": ["ES2022", "DOM"],
        "sourceMap": true,
        "outDir": "out",
        "rootDir": "src",
        "strict": true,
        "moduleResolution": "NodeNext",
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "resolveJsonModule": true,
        "jsx": "react-jsx",
        "baseUrl": ".",
        "paths": {
            "@governance/*": ["../_governance/*"],
            "@system/*": ["./src/system/*", "./src/cse/*"],
            "@domain/*": ["./src/02_domain/*"],
            "@nexus/*": ["./src/nexus/*"],
            "@fabric/*": ["./src/03_fabric/*"],
            "@atlas/*": ["./src/01_atlas/*"],
            "@essence/*": ["./src/types/*"],
            "@shield/*": ["./sentinel/*"],
            "@pulse/*": ["./_logs/*"],
            "@loom/*": ["./templates/*"],
            "@archive/*": ["./archives/*"],
            "@universe/*": ["./_universe/*"],
            "@logging": ["./src/system/logging/index.ts"],
            "@logging/*": ["./src/system/logging/*"],
            "@utils/*": ["./src/utils/*"]
        }
    },
    "include": ["src"],
    "exclude": ["node_modules", ".vscode-test", "src/nexus/useNexusHandshake.ts"]
}
