{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "ignoreDeprecations": "6.0",
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": false,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "erasableSyntaxOnly": false,
    "noFallthroughCasesInSwitch": true,

    /* Path Aliases (PRS-001) */
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@system/*": ["src/system/*", "src/core/*"],
      "@domain/*": ["src/domain/*"],
      "@nexus/*": ["src/store/*", "src/state/*"],
      "@state/*": ["src/store/*", "src/state/*"],
      "@store/*": ["src/store/*"],
      "@fabric/*": ["src/components/ui/*", "src/components/*"],
      "@atlas/*": ["src/config/*"],
      "@essence/*": ["src/types/*", "src/essence/*"],
      "@loom/*": ["src/loom/*"],
      "@core/*": ["src/core/*"],
      "@hooks/*": ["src/hooks/*", "src/core/hooks/*"],
      "@ui/*": ["src/components/*"],
      "@utils/*": ["src/utils/*"],
      "@components/*": ["src/components/*"],
      "@pages/*": ["src/components/pages/*"],
      "@synarche/*": ["../packages/*", "../packages/*/src/index.ts"]
    }
  },
  "include": ["src"],
  "exclude": ["src/**/__tests__/*", "src/**/*.test.ts", "src/**/*.stories.tsx"]
}
