{
    "name": "@synarche/design-system",
    "version": "1.0.0",
    "description": "Core design system components and tokens for Synarche Workspace.",
    "main": "dist/index.js",
    "module": "dist/index.mjs",
    "types": "dist/index.d.ts",
    "files": [
        "dist"
    ],
    "scripts": {
        "dev": "tsup src/index.ts --format cjs,esm --watch --dts",
        "build": "tsup src/index.ts --format cjs,esm --minify --clean --dts",
        "lint": "eslint \"src/**/*.ts*\"",
        "test": "vitest run",
        "storybook": "storybook dev -p 6006",
        "build-storybook": "storybook build"
    },
    "keywords": [
        "design-system",
        "react",
        "typescript",
        "synarche"
    ],
    "author": "Chris",
    "license": "MIT",
    "peerDependencies": {
        "react": ">=18",
        "react-dom": ">=18"
    },
    "devDependencies": {
        "@types/node": "^20.0.0",
        "@types/react": "^18.0.0",
        "@types/react-dom": "^18.0.0",
        "eslint": "^8.0.0",
        "storybook": "^10.4.1",
        "tsup": "^8.0.0",
        "typescript": "^5.0.0",
        "vitest": "^4.1.7"
    }
}
