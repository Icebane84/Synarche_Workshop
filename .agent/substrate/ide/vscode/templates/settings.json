{
	"[javascript]": {
		"editor.defaultFormatter": "biomejs.biome"
	},
	"[json]": {
		"editor.defaultFormatter": "biomejs.biome"
	},
	"[jsonc]": {
		"editor.defaultFormatter": "biomejs.biome"
	},
	"[markdown]": {
		"editor.codeActionsOnSave": {
			"source.fixAll": "never"
		},
		"editor.defaultFormatter": "esbenp.prettier-vscode",
		"editor.insertSpaces": true,
		"editor.tabSize": 2
	},
	"[python]": {
		"editor.codeActionsOnSave": {
			"source.fixAll": "explicit",
			"source.organizeImports": "explicit"
		},
		"editor.defaultFormatter": "charliermarsh.ruff"
	},
	"[toml]": {
		"editor.defaultFormatter": "tamasfe.even-better-toml"
	},
	"[typescript]": {
		"editor.defaultFormatter": "biomejs.biome"
	},
	"code-runner.executorMap": {
		"python": "C:\\DevEnvironments\\master_env\\Scripts\\python.exe -u"
	},
	"code-runner.runInTerminal": true,
	"cSpell.configFile": "./axion-core/standards/cspell.jsonc",
	"cSpell.customWorkspaceDictionaries": [
		{
			"addWords": true,
			"description": "Master dictionary for the Phoenix Protocol",
			"name": "Phoenix Dictionary",
			"path": "${workspaceFolder}/axion-core/standards/dictionaries/master.jsonc"
		}
	],
	"cSpell.words": [
		"AISTF",
		"Badass",
		"chronos",
		"DQUEST",
		"dragonslayer",
		"EMPR",
		"Episemantics",
		"Freeplane",
		"Gamified",
		"Gemification",
		"GVRN",
		"HIER",
		"importmap",
		"Insforge",
		"INSFORGE",
		"KAELEN",
		"Lightbinder",
		"MAGN",
		"middleware",
		"Musashi",
		"Oathkeep",
		"Oathkeeper",
		"OGLN",
		"omni-anchor",
		"OSLM",
		"params",
		"PGPS",
		"PYREFLY",
		"Pythonic",
		"QLOR",
		"scanlines",
		"Serafina",
		"SUPABASE",
		"synarche",
		"SYNG",
		"trpc",
		"zustand"
	],
	"debug.console.closeOnEnd": true,
	"diffEditor.codeLens": true,
	"editor.codeActionsOnSave": {
		"source.organizeImports.biome": "explicit"
	},
	"editor.defaultFormatter": "biomejs.biome",
	"editor.fontLigatures": true,
	"editor.fontSize": 16,
	"editor.formatOnSave": true,
	"editor.guides.bracketPairs": true,
	"editor.minimap.enabled": false,
	"editor.renderWhitespace": "selection",
	"editor.scrollOnMiddleClick": true,
	"editor.semanticHighlighting.enabled": true,
	"errorLens.fontStyleItalic": true,
	"errorLens.fontWeight": "400",
	"errorLens.gutterIconsEnabled": true,
	"errorLens.messageBackgroundMode": "line",
	"eslint.run": "onSave",
	"eslint.useFlatConfig": true,
	"eslint.validate": [
		"javascript",
		"typescript",
		"typescriptreact",
		"markdown"
	],
	"eslint.workingDirectories": [
		{
			"changeProcessCWD": true,
			"directory": "axion-core"
		},
		{
			"changeProcessCWD": true,
			"directory": "phoenix-rosetta-stone"
		},
		{
			"changeProcessCWD": true,
			"directory": "design-system"
		},
		{
			"changeProcessCWD": false,
			"directory": "."
		},
		{
			"changeProcessCWD": true,
			"directory": "open-notebook"
		},
		{
			"changeProcessCWD": true,
			"directory": "nova_forge"
		}
	],
	"explorer.excludeGitIgnore": false,
	"extension.prophet.sitecontext.selectedSiteID": "",
	"files.autoSave": "off",
	"files.watcherExclude": {
		"**/__pycache__/**": true,
		"**/_governance/**": true,
		"**/_logs/**": true,
		"**/.archives/**": true,
		"**/.git/**": true,
		"**/.mypy_cache/**": true,
		"**/.pytest_cache/**": true,
		"**/.ruff_cache/**": true,
		"**/.tmp.*": true,
		"**/.trunk/**": true,
		"**/.venv/**": true,
		"**/.vscode/**": true,
		"**/artifacts/**": true,
		"**/dist/**": true,
		"**/incoming/**": true,
		"**/node_modules/**": true,
		"**/scratch/**": true,
		"**/tmp.driveupload/**": true,
		"**/venv/**": true
	},
	"geminicodeassist.updateChannel": "Insiders",
	"java.autobuild.enabled": false,
	"java.import.gradle.enabled": false,
	"java.import.gradle.wrapper.enabled": false,
	"java.import.maven.enabled": false,
	"java.inlayHints.formatParameters.enabled": true,
	"java.inlayHints.parameterTypes.enabled": true,
	"java.jdt.ls.vmargs": "-Xmx128M -Xms64M -XX:+UseG1GC -XX:+UseStringDeduplication",
	"java.project.importHint": false,
	"java.project.importOnFirstTimeStartup": "disabled",
	"java.project.importOnFirstTimeStartup.showPrompts": false,
	"java.recommendations.dependency.install": "false",
	"java.server.launchMode": "LightWeight",
	"js/ts.preferences.importModuleSpecifier": "project-relative",
	"markdown.extension.completion.enabled": true,
	"markdown.extension.showActionButtons": true,
	"markdown.preview.typographer": true,
	"markdown.server.log": "debug",
	"markdownlint.config": {
		"MD013": false,
		"MD033": false
	},
	"markdownlint.customRules": [
		"./axion-core/standards/eslint-plugin-phoenix/markdownlint-rules/axion-rules.cjs",
		"./axion-core/standards/eslint-plugin-phoenix/markdownlint-rules/phoenix-rules.cjs"
	],
	"markdownlint.run": "onSave",
	"mypy-type-checker.args": [
		"--config-file",
		"./axion-core/standards/mypy.ini"
	],
	"mypy-type-checker.daemonStatusFile": "axion-core\\standards\\.dmypy.json",
	"mypy-type-checker.importStrategy": "fromEnvironment",
	"mypy-type-checker.interpreter": [
		"C:\\DevEnvironments\\master_env\\Scripts\\python.exe"
	],
	"mypy-type-checker.path": [
		"C:\\DevEnvironments\\master_env\\Scripts\\mypy.exe"
	],
	"mypy.debugLogging": true,
	"mypy.dmypyExecutable": "C:\\DevEnvironments\\master_env\\Scripts\\dmypy.exe",
	"notebook.defaultFormatter": "esbenp.prettier-vscode",
	"php.format.rules.addCommaAfterLastDeclParameter": true,
	"powershell.buttons.showPanelMovementButtons": true,
	"powershell.codeFormatting.autoCorrectAliases": false,
	"powershell.codeFormatting.avoidSemicolonsAsLineTerminators": true,
	"powershell.codeFormatting.whitespaceBetweenParameters": true,
	"powershell.integratedConsole.showOnStartup": false,
	"prettier.configpath": "./axion-core/standards/.prettierrc",
	"prettier.experimentalTernaries": true,
	"prettier.requireConfig": false,
	"python.analysis.autoFormatStrings": true,
	"python.analysis.autoImportCompletions": true,
	"python.analysis.completeFunctionParens": true,
	"python.analysis.diagnosticMode": "openFilesOnly",
	"python.analysis.enableTroubleshootMissingImports": true,
	"python.analysis.exclude": [
		"**/node_modules",
		"**/__pycache__",
		"**/.git",
		"**/.venv",
		"**/venv",
		"**/_governance",
		"**/.archives",
		"**/.mypy_cache",
		"**/.ruff_cache",
		"**/scratch",
		"**/incoming",
		"**/dist",
		"**/out",
		"**/.*"
	],
	"python.analysis.extrapaths": [
		"axion-core",
		"open-notebook"
	],
	"python.analysis.indexing": false,
	"python.analysis.indexing.followSymlinkedFolders": false,
	"python.analysis.inlayHints.callArgumentNames": "partial",
	"python.analysis.inlayHints.functionReturnTypes": true,
	"python.analysis.inlayHints.pytestParameters": true,
	"python.analysis.inlayHints.variableTypes": true,
	"python.analysis.referencesCodeLens": true,
	"python.analysis.typeCheckingMode": "basic",
	"python.defaultInterpreterpath": "C:\\DevEnvironments\\master_env\\Scripts\\python.exe",
	"python.pyrefly.configpath": "axion-core\\standards\\pyrefly.toml",
	"python.pyrefly.runnableCodeLens": true,
	"python.pyrefly.typeCheckingMode": "strict",
	"ruff.importStrategy": "fromEnvironment",
	"ruff.interpreter": [
		"C:\\DevEnvironments\\master_env\\Scripts\\python.exe"
	],
	"ruff.path": [
		"C:\\DevEnvironments\\master_env\\Scripts\\ruff.exe"
	],
	"search.exclude": {
		"**/__pycache__": true,
		"**/.mypy_cache": true,
		"**/.pytest_cache": true,
		"**/.ruff_cache": true,
		"**/.tmp.*": true,
		"**/dist": true,
		"**/node_modules": true,
		"**/out": true
	},
	"sonarlint.disableTelemetry": true,
	"sonarlint.rules": {
		"javascript:S106": "off"
	},
	"terminal.integrated.drawBoldTextInBrightColors": false,
	"terminal.integrated.env.windows": {
		"ESLINT_USE_FLAT_CONFIG": "true",
		"PATH": "C:\\Users\\Chris\\.cache\\trunk\\cli\\1.25.0-mingw-x86_64;C:\\DevEnvironments\\master_env\\Scripts;${env:PATH}"
	},
	"terminal.integrated.suggest.providers": {
		"lsp": true
	},
	"trunk.addToolsTopath": true,
	"trunk.numJobs": 0,
	"trunk.path": "C:\\Users\\Chris\\.cache\\trunk\\cli\\1.25.0-mingw-x86_64\\trunk.exe",
	"trunk.workspaceFolderName": "📂 WORKSPACE ROOT",
	"typescript.preferences.importModuleSpecifier": "project-relative",
	"typescript.tsserver.maxTsServerMemory": 3072
}
