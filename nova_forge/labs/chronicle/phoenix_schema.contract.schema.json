{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://synarche.local/schemas/phoenix-schema-contract.schema.json",
  "title": "Phoenix Schema Normalized Contract",
  "type": "object",
  "required": [
    "artifact",
    "poetic_layer",
    "executable_contract",
    "implementation_context",
    "policy_exceptions",
    "implementation_gaps",
    "control_extensions"
  ],
  "additionalProperties": false,
  "properties": {
    "artifact": {
      "type": "object",
      "required": [
        "artifact_id",
        "official_name",
        "canonical_version",
        "legacy_version",
        "lifecycle_state",
        "canonization_state",
        "domain",
        "status_resolution"
      ],
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "type": "string",
          "minLength": 1
        },
        "official_name": {
          "type": "string",
          "minLength": 1
        },
        "canonical_version": {
          "type": "string",
          "pattern": "^v[0-9]+\\.[0-9]+$"
        },
        "legacy_version": {
          "type": "string",
          "pattern": "^v[0-9]+\\.[0-9]+$"
        },
        "lifecycle_state": {
          "enum": [
            "DRAFT",
            "IN_REVIEW",
            "ACTIVE",
            "DEPRECATED",
            "SUPERSEDED"
          ]
        },
        "canonization_state": {
          "enum": [
            "PROPOSED",
            "CANONIZED",
            "REVOKED"
          ]
        },
        "domain": {
          "type": "string",
          "minLength": 1
        },
        "status_resolution": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "poetic_layer": {
      "type": "object",
      "required": [
        "purpose",
        "domain_groups"
      ],
      "additionalProperties": false,
      "properties": {
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "domain_groups": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/domain_group"
          }
        }
      }
    },
    "executable_contract": {
      "type": "object",
      "required": [
        "law_fields",
        "laws"
      ],
      "additionalProperties": false,
      "properties": {
        "law_fields": {
          "type": "array",
          "const": [
            "id",
            "intent",
            "principle",
            "enforcement",
            "severity",
            "test",
            "owner",
            "dependencies",
            "validation_criteria"
          ]
        },
        "laws": {
          "type": "array",
          "minItems": 42,
          "maxItems": 42,
          "items": {
            "$ref": "#/$defs/law"
          }
        }
      }
    },
    "implementation_context": {
      "type": "object",
      "required": [
        "deployment_target",
        "current_server_version",
        "compliance_posture"
      ],
      "additionalProperties": false,
      "properties": {
        "deployment_target": {
          "type": "string",
          "minLength": 1
        },
        "current_server_version": {
          "type": "string",
          "minLength": 1
        },
        "compliance_posture": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "policy_exceptions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/policy_exception"
      }
    },
    "implementation_gaps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/implementation_gap"
      }
    },
    "control_extensions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/control_extension"
      }
    }
  },
  "$defs": {
    "domain_group": {
      "type": "object",
      "required": [
        "id",
        "name",
        "purpose",
        "laws"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "laws": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^LAW-[0-9]{3}$"
          }
        }
      }
    },
    "law": {
      "type": "object",
      "required": [
        "id",
        "domain",
        "intent",
        "principle",
        "enforcement",
        "severity",
        "test",
        "owner",
        "dependencies",
        "validation_criteria"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^LAW-[0-9]{3}$"
        },
        "domain": {
          "type": "string",
          "minLength": 1
        },
        "intent": {
          "type": "string",
          "minLength": 1
        },
        "principle": {
          "type": "string",
          "minLength": 1
        },
        "enforcement": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "enum": [
            "MUST",
            "SHOULD",
            "MAY"
          ]
        },
        "test": {
          "type": "string",
          "minLength": 1
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "validation_criteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "policy_exception": {
      "type": "object",
      "required": [
        "id",
        "laws",
        "scope",
        "exception",
        "expiry",
        "required_compensating_controls"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^EXC-[0-9]{3}$"
        },
        "laws": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^LAW-[0-9]{3}$"
          }
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "exception": {
          "type": "string",
          "minLength": 1
        },
        "expiry": {
          "type": "string",
          "minLength": 1
        },
        "required_compensating_controls": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "implementation_gap": {
      "type": "object",
      "required": [
        "id",
        "laws",
        "severity",
        "finding",
        "remediation"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^GAP-[0-9]{3}$"
        },
        "laws": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^LAW-[0-9]{3}$"
          }
        },
        "severity": {
          "enum": [
            "MUST",
            "SHOULD",
            "MAY"
          ]
        },
        "finding": {
          "type": "string",
          "minLength": 1
        },
        "remediation": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "control_extension": {
      "type": "object",
      "required": [
        "id",
        "name",
        "severity",
        "enforcement",
        "test",
        "owner",
        "dependencies",
        "validation_criteria"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^CTRL-[0-9]{3}$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "enum": [
            "MUST",
            "SHOULD",
            "MAY"
          ]
        },
        "enforcement": {
          "type": "string",
          "minLength": 1
        },
        "test": {
          "type": "string",
          "minLength": 1
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "validation_criteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
