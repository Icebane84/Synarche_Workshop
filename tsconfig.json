{
  "compilerOptions": {
    "paths": {
      /* --- The Master Star-Chart (PRS-001) --- */
      "@system/*": ["./axion-core/src/system/*", "./axion-core/src/cse/*"],
      "@domain/*": ["./axion-core/src/02_domain/*"],
      "@nexus/*": ["./axion-core/src/nexus/*"],
      "@fabric/*": ["./axion-core/src/03_fabric/*"],
      "@atlas/*": ["./axion-core/src/01_atlas/*"],
      "@essence/*": ["./axion-core/src/types/*"],
      "@shield/*": ["./axion-core/sentinel/*"],
      "@pulse/*": ["./axion-core/_logs/*"],
      "@loom/*": ["./axion-core/templates/*"],
      "@archive/*": ["./axion-core/archives/*"],
      "@universe/*": ["./axion-core/_universe/*"],
      "@logging": ["./axion-core/src/system/logging/index.ts"],
      "@logging/*": ["./axion-core/src/system/logging/*"],
      "@utils/*": ["./axion-core/src/utils/*"]
    }
  },
  "exclude": [
    "node_modules",
    "**/node_modules",
    "**/node_modules/**/*",
    "dist",
    "**/dist",
    "**/dist/**/*",
    "out",
    "**/out",
    "**/out/**/*",
    ".git",
    "**/_governance",
    "**/_governance/**/*",
    "**/.archives",
    "**/.archives/**/*",
    "**/.mypy_cache",
    "**/.mypy_cache/**/*",
    "**/.ruff_cache",
    "**/.ruff_cache/**/*",
    "**/.venv",
    "**/.venv/**/*",
    "**/venv",
    "**/venv/**/*",
    "**/scratch",
    "**/scratch/**/*",
    "**/incoming",
    "**/incoming/**/*",
    "axion-core",
    "axion-core/**/*"
  ]
}
