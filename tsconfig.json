{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@system/*":  ["./axion-core/src/system/*", "./axion-core/src/cse/*"],
      "@domain/*":  ["./_governance/*"],
      "@nexus/*":   ["./axion-core/src/nexus/*"],
      "@fabric/*":  ["./design-system/*"],
      "@atlas/*":   ["./_governance/01_Registries/*"],
      "@essence/*": ["./axion-core/src/types/*"],
      "@shield/*":  ["./axion-core/sentinel/*"],
      "@pulse/*":   ["./axion-core/_logs/*"],
      "@loom/*":    ["./_governance/templates/*"],
      "@archive/*": ["./_governance/99_Archives/*"],
      "@synarche":  ["./packages"]
    }
  },
  "exclude": [
    "node_modules",
    "**/node_modules",
    "dist",
    "**/dist",
    "**/dist/**/*",
    "out",
    "**/out",
    "**/out/**/*",
    ".git",
    "**/_governance",
    "**/_governance/**/*",
    "**/.archives",
    "**/.archives/**/*",
    "**/.mypy_cache",
    "**/.mypy_cache/**/*",
    "**/.ruff_cache",
    "**/.ruff_cache/**/*",
    "**/.venv",
    "**/.venv/**/*",
    "**/venv",
    "**/venv/**/*",
    "**/scratch",
    "**/scratch/**/*",
    "**/incoming",
    "**/incoming/**/*"
  ]
}
